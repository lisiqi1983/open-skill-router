{
  "name": "open-skill-router",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first router for Agent Skills.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:smoke": "pnpm build && node scripts/smoke-m0-m2.mjs",
    "test:mcp": "pnpm build && node scripts/smoke-m3-mcp.mjs",
    "test:static": "pnpm build && node scripts/smoke-m4-static-index.mjs",
    "test:api": "pnpm build && node scripts/smoke-m5-api.mjs",
    "release:bundle": "pnpm build && node scripts/build-release-bundle.mjs",
    "test:release": "pnpm release:bundle && node scripts/smoke-m6-release-bundle.mjs",
    "test:catalog": "pnpm build && node scripts/smoke-m7-catalog.mjs",
    "test:multidim": "pnpm build && node scripts/smoke-m8-multidim-recommend.mjs",
    "test:scoring": "pnpm build && node scripts/smoke-m9-scoring-config.mjs",
    "test:analysis": "pnpm build && node scripts/smoke-m10-catalog-analysis.mjs",
    "test:search": "pnpm build && node scripts/smoke-m12-search.mjs",
    "test:recommend-search": "pnpm build && node scripts/smoke-m13-search-prefilter.mjs",
    "test:persistent-search": "pnpm build && node scripts/smoke-m14-persistent-search-index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
