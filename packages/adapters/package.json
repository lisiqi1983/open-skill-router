{
  "name": "@openskillrouter/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "Source and agent-host adapters for Open Skill Router.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck",
    "test": "pnpm --filter @openskillrouter/skill-spec build && vitest run"
  },
  "dependencies": {
    "@openskillrouter/skill-spec": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
