{
  "name": "@openskillrouter/cache",
  "version": "0.0.0",
  "private": true,
  "description": "Local cache, lockfiles, installation, and update checks for Open Skill Router.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck",
    "test": "pnpm --filter @openskillrouter/skill-spec build && pnpm --filter @openskillrouter/security build && pnpm --filter @openskillrouter/adapters build && vitest run"
  },
  "dependencies": {
    "@openskillrouter/adapters": "workspace:*",
    "@openskillrouter/security": "workspace:*",
    "@openskillrouter/skill-spec": "workspace:*",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
